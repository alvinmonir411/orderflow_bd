# ==========================================
# ORDERFLOW BD - NESTJS API SERVER ENVIRONMENT EXAMPLE
# ==========================================

# Neon Serverless PostgreSQL Database Connection
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-placeholder.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Server Port & Environment
PORT=4000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRATION="7d"

# Meta (Facebook Messenger) App Config
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
DEFAULT_FACEBOOK_PAGE_TOKEN=""
DEFAULT_FACEBOOK_PAGE_ID=""
DEFAULT_FACEBOOK_VERIFY_TOKEN="orderflow_bd_verify_token"

# WhatsApp Cloud API Config
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_VERIFY_TOKEN="orderflow_bd_secure_verify_2026"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Courier Default Sandbox/Production Base URLs
STEADFAST_BASE_URL="https://portal.packzy.com/api/v1"
PATHAO_BASE_URL="https://courier-api-sandbox.pathao.com"
